{
  "name": "mirrorads",
  "version": "141126b11",
  "private": true,
  "description": "MirrorAds: clone Facebook Ads Manager campaigns between ad accounts, with value rules and per-account campaign names.",
  "scripts": {
    "bump:build": "node scripts/bump-build-version.cjs",
    "build:payload": "node scripts/build-payload.cjs",
    "check:payload": "node scripts/build-payload.cjs --check",
    "check": "npm run lint && npm test && npm run check:payload && node --check mirrorads.js",
    "prebuild": "npm run bump:build",
    "build": "npm run build:payload",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src tests tools",
    "format": "prettier --write src tests eslint.config.mjs",
    "bookmarks": "node tools/build-bookmarks.mjs"
  },
  "keywords": [
    "facebook-ads",
    "ads-manager",
    "bookmarklet",
    "campaign-clone"
  ],
  "author": "MirrorAds",
  "license": "UNLICENSED",
  "devDependencies": {
    "acorn": "^8.18.0",
    "esbuild": "^0.25.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6"
  }
}
