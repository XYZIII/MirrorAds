{
  // Cloudflare serves the static site built by `node tools/build-site.mjs`.
  "name": "mirrorads",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    // /mirrorads/latest/manifest serves manifest.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
